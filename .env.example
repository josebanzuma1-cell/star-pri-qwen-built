# Referral-engine backend base URL.
# Leave empty (or unset) to run in localStorage demo mode.
# When set, uncomment the fetch() calls in src/services/api.js — endpoints used:
#   POST  {VITE_API_BASE}/api/ambassadors
#   GET   {VITE_API_BASE}/api/ambassadors/stats?code=STAR-XXXXX
#   POST  {VITE_API_BASE}/api/clicks
#   POST  {VITE_API_BASE}/api/leads
#   GET   {VITE_API_BASE}/api/leads
#   PATCH {VITE_API_BASE}/api/leads/:id
VITE_API_BASE=
